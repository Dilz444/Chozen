{
  "_about": "Wix URL -> Shopify URL rules, applied in order by tools/redirects/build.mjs to every URL in capture/sitemaps.json and capture/indexed.md. 'exact' rows win over patterns. Targets must exist in content/ (the script checks).",
  "exact": {
    "/": null,
    "/blank": "/",
    "/blank-3": "/",
    "/instagram-bio": "/",
    "/blog": "/blogs/journal",
    "/shop": "/collections/all",
    "/shop-1": "/collections/all",
    "/about": "/pages/about",
    "/about-us": "/pages/about",
    "/contact": "/pages/contact",
    "/contact-us": "/pages/contact",
    "/faq": "/pages/faqs",
    "/faqs": "/pages/faqs",
    "/delivery": "/pages/delivery",
    "/delivery-information": "/pages/delivery",
    "/returns": "/policies/refund-policy",
    "/returns-policy": "/policies/refund-policy",
    "/refund-policy": "/policies/refund-policy",
    "/privacy": "/policies/privacy-policy",
    "/privacy-policy": "/policies/privacy-policy",
    "/terms": "/policies/terms-of-service",
    "/terms-and-conditions": "/policies/terms-of-service",
    "/claims-payment": "/pages/contact",
    "/subscription": "/pages/flower-subscription",
    "/floral-hire": "/pages/floral-hire",
    "/buy-back-programme": "/pages/buy-back-programme",
    "/buy-back-program": "/pages/buy-back-programme",
    "/ethical-sourcing": "/pages/ethical-sourcing",
    "/crystal-library": "/blogs/guides/crystal-meanings",
    "/crystals-by-colour": "/blogs/guides/crystals-by-colour",
    "/crystals-by-color": "/blogs/guides/crystals-by-colour",
    "/crystals-by-intention": "/blogs/guides/crystal-meanings",
    "/crystals-by-formation": "/blogs/guides/crystal-meanings",
    "/astrology": "/blogs/guides/zodiac-crystals",
    "/astrology-pairing": "/blogs/guides/zodiac-crystals",
    "/anniversary-guide": "/blogs/guides/anniversary-flowers-by-year",
    "/greetings-card-messages": "/blogs/guides/what-to-write-in-a-card",
    "/greeting-card-messages": "/blogs/guides/what-to-write-in-a-card",
    "/crystal-gifting-guide": "/blogs/guides/crystal-meanings"
  },
  "patterns": [
    { "match": "^/product-page/(.+)$", "to": "/collections/all", "note": "Wix placeholders ('Flower 2', 'Bouquet 1') aren't ported; map each by hand to its closest collection once real products exist. Fresh-looking slugs (flower|bouquet|rose|balloon) go to /collections/same-day-flowers." },
    { "match": "^/product-page/.*(flower|bouquet|rose|peony|tulip|lily).*$", "to": "/collections/same-day-flowers" },
    { "match": "^/product-page/.*(balloon).*$", "to": "/collections/balloon-gift-sets" },
    { "match": "^/product-page/.*(faux|artificial|silk).*$", "to": "/collections/faux-flowers" },
    { "match": "^/product-page/.*(crystal|quartz|amethyst|citrine|tourmaline|selenite|obsidian|agate|jade).*$", "to": "/collections/crystals" },
    { "match": "^/product-page/.*(bracelet|necklace|ring|earring|pendant|jewellery|jewelry).*$", "to": "/collections/gemstone-jewellery" },
    { "match": "^/category/(.+)$", "to": "/collections/$1", "note": "only if a collection with that handle exists; else /collections/all" },
    { "match": "^/post/(.+)$", "to": "/blogs/journal/$1" },
    { "match": "^/blog/categories/(.+)$", "to": "/blogs/journal/tagged/$1" },
    { "match": "^/blog/tags/(.+)$", "to": "/blogs/journal/tagged/$1" },
    { "match": "^/blog/page/\\d+$", "to": "/blogs/journal" }
  ]
}
