        "q1": {
          "type": "question",
          "settings": {
            "question": "What time do I need to order for same-day delivery?",
            "answer": "Order by 10am and we deliver the same day. Orders after 10am go out on the next delivery day, and you can choose a later date at checkout."
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Can I add a card message?",
            "answer": "Yes. Type your message when you add the flowers to your basket and it goes on a card with your gift."
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Do you send flowers outside London?",
            "answer": "Fresh flowers and balloons stay local, because we deliver them by hand. Faux flowers, crystals and jewellery are posted anywhere in the UK."
          }
        },
