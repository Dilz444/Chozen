<div class="wrap pg-body" style="text-align:center; padding-top: 64px">
  <p class="eyebrow">Florist · Enfield, North London</p>
  <h1 style="font-size: 44px">Opening soon</h1>
  <p class="lede" style="margin: 12px auto 28px">{{ shop.password_message | default: 'Fresh flowers and balloon gift sets, hand-delivered in Enfield. Back very soon.' }}</p>
  {%- form 'storefront_password', class: 'search-form' -%}
    {%- if form.errors -%}<p class="form-err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label class="vh" for="pw">Password</label>
    <input id="pw" type="password" name="password" autocomplete="current-password" placeholder="Password">
    <button class="btn btn--primary" type="submit">Enter</button>
  {%- endform -%}
</div>
{% schema %}
{ "name": "Password page" }
{% endschema %}
