{% render 'breadcrumbs', trail: blog.title %}
<div class="wrap pg-body">
  <header class="pg-head">
    <h1>{{ blog.title }}</h1>
    {%- if blog.metafields.custom.lede.value != blank -%}<p class="lede">{{ blog.metafields.custom.lede.value }}</p>{%- endif -%}
  </header>
  {%- paginate blog.articles by 24 -%}
    <ul class="blog-list" style="margin-top: 28px">
      {%- for article in blog.articles -%}
        <li class="blog-card">
          <a href="{{ article.url }}">
            <span class="blog-card__img{% if article.image == blank %} ph{% cycle '', ' ph--alt' %}{% endif %}"{% if article.image == blank %} data-label="{{ 'general.photo_to_come' | t }}"{% endif %} style="display:block">
              {%- if article.image -%}{% render 'image', image: article.image, sizes: '(min-width: 64em) 33vw, (min-width: 48em) 50vw, 100vw' %}{%- else -%}<svg viewBox="0 0 400 400" aria-hidden="true" focusable="false"><use href="#s-{% cycle 'bouquet', 'crystals', 'faux', 'balloons' %}"/></svg>{%- endif -%}
            </span>
            <h2>{{ article.title }}</h2>
            <p>{{ article.excerpt | strip_html | truncatewords: 26 }}</p>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pages">{%- for part in paginate.parts -%}{%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span{% if part.title == paginate.current_page %} aria-current="page"{% endif %}>{{ part.title }}</span>{%- endif -%}{%- endfor -%}</nav>{%- endif -%}
  {%- endpaginate -%}
</div>
{% schema %}
{ "name": "Blog" }
{% endschema %}
