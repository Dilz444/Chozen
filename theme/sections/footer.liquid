<footer class="ftr">
  <div class="wrap ftr__in">
    <div class="ftr__brand">
      <a class="logo logo--ftr" href="{{ routes.root_url }}" aria-label="{{ shop.name }}, {{ 'general.home' | t | downcase }}"><svg class="logo__mark" aria-hidden="true" focusable="false"><use href="#i-jasmine"/></svg><span class="logo__word">ChoZen</span><span class="logo__sub">Boutique</span></a>
      <p>{{ section.settings.blurb }}</p>
      <address class="nap">
        {%- if settings.phone != blank -%}<a href="tel:{{ settings.phone | remove: ' ' }}">{{ settings.phone }}</a>{%- endif -%}
        {%- if settings.email != blank -%}<a href="mailto:{{ settings.email }}">{{ settings.email }}</a>{%- endif -%}
        <span class="ftr__addr">{% render 'tbc', text: settings.street_address %}, Enfield {% render 'tbc', text: settings.postcode %}</span>
      </address>
      <ul class="social">
        {%- if settings.instagram != blank -%}<li><a href="{{ settings.instagram }}" aria-label="Instagram"><svg aria-hidden="true" focusable="false"><use href="#i-insta"/></svg></a></li>{%- endif -%}
        {%- if settings.tiktok != blank -%}<li><a href="{{ settings.tiktok }}" aria-label="TikTok"><svg aria-hidden="true" focusable="false"><use href="#i-tiktok"/></svg></a></li>{%- endif -%}
        {%- if settings.facebook != blank -%}<li><a href="{{ settings.facebook }}" aria-label="Facebook"><svg aria-hidden="true" focusable="false"><use href="#i-fb"/></svg></a></li>{%- endif -%}
      </ul>
    </div>
    {%- for i in (1..3) -%}
      {%- assign key = 'menu_' | append: i -%}
      {%- assign m = linklists[section.settings[key]] -%}
      {%- if m.links.size > 0 -%}
      <nav class="ftr__col" aria-label="{{ m.title }}">
        <h2>{{ m.title }}</h2>
        {%- for link in m.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      </nav>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="wrap ftr__legal">
    <p>© {{ 'now' | date: '%Y' }} {{ shop.name }} · {% render 'tbc', text: settings.legal_line %}</p>
    <p><a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}">Terms</a> · <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy</a> · <a href="/pages/cookies">Cookies</a> · <a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">Returns</a></p>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "blurb", "label": "Short description", "default": "Florist and gift boutique in Enfield, North London." },
    { "type": "link_list", "id": "menu_1", "label": "First menu", "default": "footer" },
    { "type": "link_list", "id": "menu_2", "label": "Second menu" },
    { "type": "link_list", "id": "menu_3", "label": "Third menu" }
  ]
}
{% endschema %}
