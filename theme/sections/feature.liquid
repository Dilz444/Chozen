<section class="feature" id="{{ section.settings.anchor | default: section.id }}" aria-labelledby="ft-{{ section.id }}">
  <div class="feature__media{% if section.settings.image == blank %} ph ph--alt{% endif %}"{% if section.settings.image == blank %} data-label="{{ 'general.photo_to_come' | t }}: {{ section.settings.placeholder_label }}"{% endif %}>
    {%- if section.settings.image != blank -%}
      {% render 'image', image: section.settings.image, sizes: '(min-width: 48em) 50vw, 100vw' %}
    {%- else -%}
      <svg viewBox="0 0 400 400" aria-hidden="true" focusable="false"><use href="#s-{{ section.settings.scene }}"/></svg>
    {%- endif -%}
  </div>
  <div class="feature__text">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 id="ft-{{ section.id }}">{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    {%- if section.settings.cta_label != blank -%}
      <a class="btn btn--primary" href="{{ section.settings.cta_link | default: '/collections/balloon-gift-sets' }}">{{ section.settings.cta_label }} <svg aria-hidden="true" focusable="false"><use href="#i-arrow"/></svg></a>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Feature",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "balloons" },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "select", "id": "scene", "label": "Placeholder drawing", "options": [{ "value": "balloons", "label": "Balloons" }, { "value": "bouquet", "label": "Bouquet" }, { "value": "faux", "label": "Vase" }], "default": "balloons" },
    { "type": "text", "id": "placeholder_label", "label": "Placeholder label", "default": "a balloon gift set at a front door" },
    { "type": "text", "id": "eyebrow", "label": "Small line", "default": "Balloon gift sets" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Can you send flowers and balloons together?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Yes. Pick a bouquet, add a balloon set, and both arrive together on the same delivery, made up in Enfield and delivered by hand. Birthdays, new babies and \"well done\" days are what they're made for." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Shop balloon gift sets" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Feature" }]
}
{% endschema %}
