{%- comment -%} Questions from blocks, rendered visibly and as FAQPage JSON-LD from the same text. {%- endcomment -%}
<div class="sec"><div class="wrap">
  {% render 'faq-list', faqs: section.blocks, heading: section.settings.heading, id: section.id, open_first: true %}
</div></div>
{% schema %}
{
  "name": "Questions",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Questions people ask" }],
  "blocks": [{ "type": "question", "name": "Question", "settings": [{ "type": "text", "id": "question", "label": "Question" }, { "type": "textarea", "id": "answer", "label": "Answer" }] }],
  "presets": [{ "name": "Questions" }]
}
{% endschema %}
