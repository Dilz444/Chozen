<section class="sec sec--band news" aria-labelledby="nl-{{ section.id }}">
  <div class="wrap news__in">
    <div>
      <h2 id="nl-{{ section.id }}" class="h2-sm">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    {%- form 'customer', class: 'news__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}<p class="form-ok" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
      <label class="vh" for="nl-email-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
      <input id="nl-email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.label' | t }}">
      <button class="btn btn--primary" type="submit">{{ 'newsletter.button' | t }}</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hear about new flowers first" },
    { "type": "text", "id": "text", "label": "Text", "default": "Seasonal bouquets and the dates to remember, a few times a month. No spam." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
