{%- liquid
  assign menu = linklists[section.settings.menu]
-%}
<header class="hdr">
  <div class="hdr__in">
    <button class="icon-btn hdr__menu" type="button" aria-label="{{ 'general.menu' | t }}" aria-controls="drawer" aria-expanded="false" data-drawer-open>
      <svg aria-hidden="true" focusable="false"><use href="#i-menu"/></svg>
    </button>
    <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}, {{ 'general.home' | t | downcase }}">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 520 | image_tag: widths: '160, 260, 520', sizes: '160px', alt: shop.name, loading: 'eager', style: 'width: 160px; height: auto' }}
      {%- else -%}
        <svg class="logo__mark" aria-hidden="true" focusable="false"><use href="#i-jasmine"/></svg>
        <span class="logo__word">ChoZen</span>
        <span class="logo__sub">Boutique</span>
      {%- endif -%}
    </a>
    <nav class="hdr__nav" aria-label="Main">
      {%- for link in menu.links -%}
        <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>
    <div class="hdr__tools">
      <a class="icon-btn hdr__search" href="{{ routes.search_url }}" aria-label="{{ 'general.search' | t }}"><svg aria-hidden="true" focusable="false"><use href="#i-search"/></svg></a>
      <a class="icon-btn hdr__cart" href="{{ routes.cart_url }}" aria-label="{{ 'general.basket_count' | t: count: cart.item_count }}">
        <svg aria-hidden="true" focusable="false"><use href="#i-bag"/></svg>
        {%- if cart.item_count > 0 -%}<span class="hdr__count" aria-hidden="true">{{ cart.item_count }}</span>{%- endif -%}
      </a>
    </div>
  </div>
</header>

<div class="drawer" id="drawer" role="dialog" aria-modal="true" aria-label="{{ 'general.menu' | t }}" hidden>
  <div class="drawer__scrim" data-drawer-close></div>
  <div class="drawer__panel">
    <div class="drawer__top">
      <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}"><svg class="logo__mark" aria-hidden="true" focusable="false"><use href="#i-jasmine"/></svg><span class="logo__word">ChoZen</span> <span class="logo__sub">Boutique</span></a>
      <button class="icon-btn" type="button" aria-label="{{ 'general.close' | t }}" data-drawer-close><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button>
    </div>
    <nav aria-label="Main">
      {%- for link in menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
        {%- if link.links.size > 0 -%}
          <div class="sub">{%- for child in link.links -%}<a href="{{ child.url }}">{{ child.title }}</a>{%- endfor -%}</div>
        {%- endif -%}
      {%- endfor -%}
      <a href="{{ routes.search_url }}">{{ 'general.search' | t }}</a>
    </nav>
    <div class="drawer__foot">
      <span>{% render 'cutoff' %}</span>
      {%- if settings.phone != blank -%}<a href="tel:{{ settings.phone | remove: ' ' }}">{{ settings.phone }}</a>{%- endif -%}
      <a href="/pages/delivery">Delivery areas and prices</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
