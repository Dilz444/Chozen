{%- comment -%}
  Visible questions and the FAQPage JSON-LD built from the same list, so the two can't drift apart.
  faqs: an array of { "q": "...", "a": "..." } (a metafield of type json, custom.faq). heading: optional.
{%- endcomment -%}
{%- if faqs != blank and faqs.size > 0 -%}
<section class="faq" aria-labelledby="faq-{{ id | default: 'list' }}">
  <h2 id="faq-{{ id | default: 'list' }}">{{ heading | default: 'Questions people ask' }}</h2>
  {%- for f in faqs -%}
    <details{% if forloop.first and open_first %} open{% endif %}>
      <summary>{{ f.q }}</summary>
      <p>{% render 'tbc', text: f.a %}</p>
    </details>
  {%- endfor -%}
</section>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for f in faqs -%}
        { "@type": "Question", "name": {{ f.q | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ f.a | remove: ' [to confirm]' | json }} } }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
{%- endif -%}
