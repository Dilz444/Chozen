{
 "_about": "Copy lint for ChoZen Boutique: the machine-checkable half of copy-voice.md. Ported from the Book London Nightclubs gate (generic families only) plus ChoZen's health-claims, overclaim, placeholder and dark-pattern rules. Read by _gate/checks/copy.mjs. level: fail (default) | warn | info.",
 "scope": {
  "visible": "text inside <main>, plus <title>, meta description and image alt",
  "excludeSelectors": [
   ".tbc",
   ".sample",
   "script",
   "style",
   ".ph",
   "[data-gate-skip]"
  ]
 },
 "exceptions": {
  "strip": [
   "Crystals are sold as decorative and spiritual items. Their traditional meanings are not scientifically proven and are not a substitute for medical advice or treatment.",
   "Warning: children under 8 years can choke or suffocate on uninflated or broken balloons. Adult supervision is required. Keep uninflated balloons away from children. Discard broken balloons at once.",
   "heat-treated",
   "untreated"
  ],
  "pathRuleWhitelist": {
   "/blogs/guides/flowers-and-pets": [
    "health-claims:pain",
    "health-claims:conditions",
    "health-claims:medical"
   ],
   "/policies/privacy-policy": [
    "health-claims:medical"
   ],
   "/policies/refund-policy": [
    "health-claims:medical"
   ],
   "/blogs/guides/balloon-care": [
    "health-claims:medical"
   ]
  }
 },
 "bannedPhrases": {
  "sellingWordsAndAiTells": [
   {
    "id": "sell-core",
    "match": "regex",
    "pattern": "\\belevat(e|ed|es|ing)\\b|\\bunlock\\w*\\b|\\bultimate\\b|\\bcurated\\b|\\bnestled\\b|\\bvibrant\\b|\\bboasts?\\b|\\bseamless(ly)?\\b",
    "flags": "i",
    "reason": "Brand brief banned words and the classic AI set.",
    "scope": "visible"
   },
   {
    "id": "sell-phrases",
    "match": "regex",
    "pattern": "\\bwhether you['’]re\\b|\\blook no further\\b|\\bin the heart of\\b|\\bsomething for everyone\\b|\\bthe perfect (night|place|spot|way|venue|choice)\\b|\\bperfect for\\b|\\ba night to remember\\b|\\bnext level\\b|\\btake your night\\b|\\bthe place to be\\b|\\bsee and be seen\\b|\\bwe['’]ve got you covered\\b|\\brest assured\\b|\\btreat yourself\\b",
    "flags": "i",
    "reason": "Stock selling phrases.",
    "scope": "visible"
   },
   {
    "id": "sell-adjectives",
    "match": "regex",
    "pattern": "\\bunforgettable\\b|\\bworld-class\\b|\\bpremier\\b|\\bluxurious\\b|\\bindulge\\b|\\bimmers(e|ive)\\b|\\biconic\\b|\\bhidden gem\\b|\\bbespoke\\b|\\bstate-of-the-art\\b|\\btop-notch\\b|\\bsecond to none\\b|\\bhot ?spot\\b|\\brenowned\\b|\\blegendary\\b|\\bstunning\\b|\\bbreathtaking\\b|\\belectric atmosphere\\b|\\bbuzzing\\b|\\beffortless(ly)?\\b|\\bhassle-free\\b|\\bstress-free\\b|\\blavish\\b|\\bopulent\\b|\\bsophisticated\\b|\\bdiscerning\\b|\\belite\\b|\\bA-list\\b|\\bstar-studded\\b|\\bred[- ]carpet\\b|\\bmust-(visit|see)\\b|\\bglamorous\\b",
    "flags": "i",
    "reason": "Adjectives instead of specifics. Give the night, the price, the street.",
    "scope": "visible"
   },
   {
    "id": "ai-tells",
    "match": "regex",
    "pattern": "\\bdelve\\b|\\bdive into\\b|\\bembark\\b|\\btapestry\\b|\\btestament to\\b|\\bit['’]s worth noting\\b|\\bin conclusion\\b|\\bnavigat(e|ing) the\\b|\\bgame-changer\\b|\\bwhen it comes to\\b|\\bnot only\\b[^.]{0,60}\\bbut also\\b",
    "flags": "i",
    "reason": "Machine-writing tells.",
    "scope": "visible"
   },
   {
    "id": "sell-florist",
    "match": "regex",
    "pattern": "\\bgorgeous\\b|\\bexquisite\\b|\\btimeless\\b|\\bthe perfect gift\\b|\\bluxury\\b|\\bpremium\\b|\\belevate\\b|\\bwow\\b|\\bbest florist\\b|\\baward[- ]winning\\b",
    "flags": "i",
    "reason": "Florist hype. Say what's in it, the size and the price.",
    "scope": "visible"
   }
  ],
  "processNarration": [
   {
    "id": "pn-this-page",
    "match": "regex",
    "pattern": "\\bthis page (covers|lists|shows|explains)\\b|\\b(is|are) (listed|shown) (above|below)\\b",
    "flags": "i",
    "reason": "Page narration.",
    "scope": "visible"
   },
   {
    "id": "pn-welcome",
    "match": "regex",
    "pattern": "\\bwelcome to (our|the) (website|site|shop|store)\\b|\\bbelow you['’]ll find\\b|\\bscroll (down|below)\\b|\\bbrowse our\\b|\\bclick here\\b",
    "flags": "i",
    "reason": "The page describing itself.",
    "scope": "visible"
   }
  ],
  "researchNotes": [
   {
    "id": "rn-notes",
    "match": "regex",
    "pattern": "\\(unverified\\)|\\(secondary\\)|\\bunverified\\b|\\baccording to (wikipedia|our research)\\b|\\bas of \\d{1,2} \\w+ 20\\d\\d\\b|\\[Solicitor\\]|\\[TS\\]",
    "flags": "i",
    "reason": "Research notes don't go in visible text.",
    "scope": "visible"
   }
  ],
  "usTerms": [
   {
    "id": "us-spelling",
    "match": "regex",
    "pattern": "\\b(color|colors|center|favorite|jewelry|personalized|organize|realize|cozy|fulfill|gray|mom|zip code|cell ?phone)\\b",
    "flags": "",
    "reason": "UK English: colour, jewellery, personalised, mum, postcode, mobile.",
    "scope": "visible",
    "caseSensitive": true
   },
   {
    "id": "us-terms",
    "match": "regex",
    "pattern": "\\b(shopping cart|add to cart|your cart|mail(ed)? to you|vacation)\\b",
    "flags": "i",
    "reason": "UK words: basket, post.",
    "scope": "visible"
   }
  ],
  "overclaims": [
   {
    "id": "oc-forever",
    "match": "regex",
    "pattern": "\\blasts? forever\\b|\\bnever (wilts?|fades?|dies)\\b|\\balways fresh\\b|\\b100% (fresh|satisfaction)\\b|\\bguaranteed\\b",
    "flags": "i",
    "reason": "Promises we can't keep (CAP 3.7).",
    "scope": "visible"
   }
  ],
  "darkPatterns": [
   {
    "id": "dp-scarcity",
    "match": "regex",
    "pattern": "\\bonly \\d+ left\\b|\\bselling fast\\b|\\bhurry\\b|\\blast chance\\b|\\bdon['’]t miss out\\b",
    "flags": "i",
    "reason": "Fake urgency or scarcity (DMCC Act, CAP 3).",
    "scope": "visible"
   }
  ],
  "contact": [
   {
    "id": "ct-hotmail",
    "match": "regex",
    "pattern": "hotmail\\.(com|co\\.uk)",
    "flags": "i",
    "reason": "The domain email replaces hotmail everywhere public (fixes.md #10).",
    "scope": "html",
    "level": "warn"
   }
  ]
 },
 "healthClaims": {
