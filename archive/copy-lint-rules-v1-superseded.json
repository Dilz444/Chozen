 },
 "placeholders": {
  "_about": "Unconfirmed facts. Warn in preview mode, FAIL in launch mode (npm run gate -- --launch).",
  "pattern": "\\[(to confirm|PRICE|FEE|ADDRESS|HOURS|LEGAL NAME|EN POSTCODE|ICO NUMBER|TRADING NAME|her words to come|her notes to come|weeks ahead|x|[A-Z][A-Z ]{2,})[^\\]]*\\]|\\bSample\\b(?=[: ])|£—",
  "flags": ""
 },
 "headingRules": {
  "fail": [
   {
    "id": "h-colon",
    "pattern": ":",
    "reason": "No colons in headings."
   },
   {
    "id": "h-compound",
    "pattern": "\\?.+\\?",
    "reason": "Two questions in one heading."
   },
   {
    "id": "h-we-question",
    "pattern": "^(Are|How are|Who are|Why do|What do|Can|Do) we\\b",
    "reason": "The reader asks 'you', never 'we'."
   },
   {
    "id": "h-search-string",
    "pattern": "^(How to|Where to|What to)\\b|\\bnear me\\b",
    "flags": "i",
    "reason": "A search string pasted as a heading."
   }
  ],
  "maxWords": 14,
  "approvedLabels": [
   "What's in it",
   "Size",
   "Delivery",
   "Care",
   "More questions",
   "You might also like",
   "Questions people ask",
   "Questions families ask",
   "Shop",
   "Help",
   "ChoZen",
   "In this guide",
   "Flowers for today",
   "Flowers we can bring today",
   "Hear about new flowers first",
   "Gifts that last",
   "Fresh flowers for today",
   "Your basket",
   "Search"
  ]
 },
 "ledeRules": {
  "maxSentences": 2,
  "maxWords": 45,
  "mustNotStartWithNumeral": "^\\d",
  "brandMaxInLede": 1,
  "exempt": [
   "/",
   "/cart",
   "/search"
  ]
 },
 "proseRules": [
  {
   "id": "p-colon-chain",
   "pattern": ":[^.?!]*:",
   "level": "warn",
   "why": "Two colons in one sentence."
  },
  {
   "id": "p-semicolon-chain",
   "pattern": ";[^.?!]*;",
   "level": "warn",
   "why": "Two semicolons in one sentence."
  },
  {
   "id": "p-starts-numeral",
   "pattern": "^\\d+ (\\w+ )?(flowers|stems|roses|bouquets|crystals|of)\\b",
   "level": "warn",
   "why": "Spell out or reorder."
  },
  {
   "id": "p-brand-subject",
   "pattern": "ChoZen Boutique (offers|provides|is proud|prides|aims)",
   "level": "fail",
   "why": "Say 'we'."
  }
 ],
 "emDashMax": 3,
 "repetition": {
  "minWords": 6,
  "maxPerPage": 2,
  "_about": "An identical sentence of 6+ words may appear at most twice on a page (copy-voice rule 12)."
 },
 "areaSimilarity": {
  "minWords": 6,
  "_about": "No sentence of 6+ words may appear on two different area pages (copy-voice rule 'area pages are not doorway pages')."
 }
}